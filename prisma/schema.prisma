generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  users     User[]

  @@map("companies")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("User")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Generic JSON document store backing lib/providers' DocumentStore interface
/// (connections, model providers, conversations, playbook, …) when
/// METADATA_DRIVER=postgres. One row per document; `collection` distinguishes
/// resource types the same way a Firestore collection or an in-memory Map
/// bucket would. See lib/providers/postgres.ts.
model AppDocument {
  id         String   @id @default(cuid())
  collection String
  tenantId   String
  docId      String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([collection, tenantId, docId])
  @@index([collection, tenantId])
  @@map("app_documents")
}

/// Per-item sustainability reference data (weight, volume, embodied CO2e),
/// AI-estimated from the item catalog. Keyed by item_id, matching the
/// Sheet's own Items.ID / Ewaste.ID (same value in both tabs) — that is the
/// real stable identifier in the source catalog. item_name is kept unique
/// and required alongside it because it is the only join key that works
/// against the externally-owned Report table: Report has no numeric item ID,
/// only a free-text "Description" column. Report is joined to this table by
/// item_name at report-generation time; nothing here is written into Report
/// itself.
model ItemSustainability {
  itemId                  String    @id @map("item_id")
  itemName                String    @unique @map("item_name")
  category                String?
  classification          String?
  weightKg                Float?    @map("weight_kg")
  weightSource            String?   @map("weight_source")
  volumeM3                Float?    @map("volume_m3")
  materialCategory        String?   @map("material_category")
  emissionFactorKgCo2eKg  Float?    @map("emission_factor_kg_co2e_per_kg")
  co2eKg                  Float?    @map("co2e_kg")
  estimationNotes         String?
  estimatedAt             DateTime? @map("estimated_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("item_sustainability")
}

/// One-time snapshot mirror of the Google Sheet's Inventory tab — one row
/// per individual physical asset within a Register transaction, linking it
/// to its Item, Hospital, Warehouse and Client (all by Sheet ID) and back to
/// its parent Register entry. Column names match the Sheet exactly so this
/// reads as a literal, auditable copy of the source, not a reinterpretation
/// of it. Populated by a migration script, not a live sync — re-run it to
/// refresh. `Report.ID` corresponds to `Inventory.ID`.
model Inventory {
  id                 String    @id @map("ID")
  sn                 String?   @map("SN")
  createdBy          String?   @map("Created by")
  createdDateTime    DateTime? @map("Created DateTime")
  lastEditedBy       String?   @map("Last Edited by")
  lastEditedDateTime DateTime? @map("Last Edited DateTime")
  register           String?   @map("Register")
  dateTime           DateTime? @map("DateTime")
  type               String?   @map("Type")
  inventoriedId      String?   @map("Inventoried ID")
  item               String?   @map("Item")
  hospital           String?   @map("Hospital")
  warehouse          String?   @map("Warehouse")
  client             String?   @map("Client")
  quantity           Float?    @map("Quantity")
  unitPrice          Float?    @map("Unit Price")
  price              Float?    @map("Price")
  assetNo            String?   @map("Asset No")
  description        String?   @map("Description")

  @@map("Inventory")
}

/// One-time snapshot mirror of the Google Sheet's Hospitals tab. "Hospital
/// Group" is the authoritative corporate-group classification (e.g. "Life
/// Healthcare", "Mediclinic") — not derivable from Hospital Name text, which
/// is why this table exists: it lets a report be scoped to a whole group,
/// joined by Report."Hospital Name" = Hospitals."Hospital Name". Column
/// names match the Sheet exactly, same convention as Inventory. Populated by
/// a migration script, not a live sync.
model Hospital {
  id              String    @id @map("ID")
  createdBy       String?   @map("Created by")
  createdDateTime DateTime? @map("Created DateTime")
  lastEditedBy    String?   @map("Last Edited by")
  lastEditedDateTime DateTime? @map("Last Edited DateTime")
  counter         Float?    @map("Counter")
  hospitalType    String?   @map("Hospital Type")
  hospitalName    String?   @map("Hospital Name")
  address         String?   @map("Address")
  map             String?   @map("Map")
  phone           String?   @map("Phone")
  email           String?   @map("Email")
  hospitalSize    String?   @map("Hospital Size")
  contactName     String?   @map("Contact Name")
  hoContactName   String?   @map("HO Contact Name")
  hoAddress       String?   @map("HO Address")
  hoContactNumber String?   @map("HO Contact Number")
  hoEmail         String?   @map("HO Email")
  hospitalGroup   String?   @map("Hospital Group")
  availableStock  Float?    @map("Available Stock")
  unitPrice       Float?    @map("Unit Price")
  totalPrice      Float?    @map("Total Price")

  @@map("Hospitals")
}

/// Encrypted key/value secret store backing lib/providers' SecretStore
/// interface (connection passwords, model-provider API keys) when
/// SECRET_DRIVER=postgres. Same AES-256-GCM scheme as lib/crypto.ts — the
/// plaintext exists only at write time and at the moment a connector
/// actually needs it.
model AppSecret {
  handle    String   @id
  valueEnc  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_secrets")
}
