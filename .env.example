# Backend configuration. Copy to .env.local and edit what you need.
#
# Nothing here is required. The app runs with no .env at all: every provider
# defaults to an in-memory driver and the workspace seeds itself on first
# request. That is a development affordance — see docs/backend/configuration.md
# before deploying.

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# The preferred way to configure this is Settings → Model provider in the app:
# the key is stored per workspace in the secret store, and several providers can
# be kept side by side to compare. The variables below are the fallback for
# deployments configured entirely through the environment (CI, containers), and
# are only used when a workspace has no provider of its own.
#
# Without either, runs return the setup notice. Everything else in the API works.

# Anthropic (the default provider)
ANTHROPIC_API_KEY=

# Any other provider. MODEL_PROVIDER takes a preset ID — see the `presets` array
# from GET /api/v1/model-providers for the full list:
#   anthropic | qwen | openai | deepseek | groq | mistral | openrouter |
#   together | ollama | custom
#
# Qwen (Alibaba DashScope), international endpoint:
# MODEL_PROVIDER=qwen
# MODEL_API_KEY=sk-...
# AGENT_MODEL=qwen-max
# For mainland China, override the endpoint:
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# Anything else speaking the OpenAI Chat Completions API:
# MODEL_PROVIDER=custom
# MODEL_BASE_URL=https://api.example.com/v1
# MODEL_API_KEY=...
# AGENT_MODEL=...

# AGENT_EFFORT=high            # Anthropic only: low | medium | high | xhigh | max
# AGENT_MAX_TOKENS=32000
# AGENT_MAX_ITERATIONS=12      # model↔tool round trips before the loop gives up
# MODEL_REQUEST_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Providers — all default to memory/env
# ---------------------------------------------------------------------------
# METADATA_DRIVER=firestore          # memory | firestore
# KV_DRIVER=firestore                # memory | firestore
# BLOB_DRIVER=gcs                    # memory | gcs | s3
# SECRET_DRIVER=gcp-secret-manager   # env | gcp-secret-manager

# --- Google Cloud (authentication is Application Default Credentials) ---
# GOOGLE_CLOUD_PROJECT=
# FIRESTORE_DATABASE_ID=
# FIRESTORE_ROOT_COLLECTION=tenants
# KV_COLLECTION=kv
# GCS_BUCKET=
# GCS_PREFIX=
# SECRET_MANAGER_PREFIX=dbagent-prod

# --- AWS / S3-compatible object storage ---
# S3_BUCKET=
# AWS_REGION=
# S3_ENDPOINT=          # for MinIO, R2, Ceph
# S3_PREFIX=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Per tenant, per minute.
# RATE_LIMIT_READ=600
# RATE_LIMIT_WRITE=120
# RATE_LIMIT_QUERY=60
# RATE_LIMIT_RUN=30

# SCHEMA_CACHE_TTL_SECONDS=900
# MAX_UPLOAD_BYTES=20971520
# BIGQUERY_MAX_BYTES_BILLED=1073741824

# ---------------------------------------------------------------------------
# Workspace bootstrap
# ---------------------------------------------------------------------------
# WORKSPACE_NAME=Local workspace
# BOOTSTRAP_USER_NAME=Local admin
# BOOTSTRAP_USER_EMAIL=admin@localhost

# Unauthenticated requests act as the local workspace admin in development.
# Set to 'required' to force API keys locally. Production always requires them,
# whatever this says.
# API_AUTH_MODE=open

# ---------------------------------------------------------------------------
# Database credentials, when SECRET_DRIVER=env
# ---------------------------------------------------------------------------
# The env driver reads a connection's credentials from SECRET_<HANDLE>, where
# the handle is upper-snake-cased. Value is the JSON credentials object.
# SECRET_CONNECTION_CREDENTIALS_CONN_01K2M9X4=' {"host":"...","username":"...","password":"..."} '
